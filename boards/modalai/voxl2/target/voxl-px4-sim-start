#!/bin/sh
# PX4 commands need the 'px4-' prefix in bash.
# (px4-alias.sh is expected to be in the PATH)
. px4-alias.sh

################################################################################
# voxl-px4-sim-start
#
# PX4 start script for voxl-mvx-simulator sim mode: PX4 SIH (simulation in
# hardware) on a VOXL2 FPV aircraft, flown with the pilot's real radio.
#
# voxl-px4 runs this script instead of voxl-px4-start ONLY when the sim-mode
# flag file /data/modalai/mvx-sim-mode contains "sim". In live mode the flag
# file does not exist and this script is never run. Legacy Gazebo HITL
# (voxl-px4-hitl) does not use this script.
#
# PX4's simulator_sih module on the DSP models the vehicle and publishes the
# IMU (at IMU_GYRO_RATEMAX), the groundtruth topics, and (with
# sensor_baro_sim and, on GPS airframes, sensor_gps_sim / sensor_mag_sim) the
# other sensors. voxl-mvx-simulator renders the FPV video from the pose,
# which a dedicated localhost mavlink instance streams as
# HIL_STATE_QUATERNION.
#
# Derived from voxl-px4-sih-start, with RC, processing modules, bridges,
# mavlink links and logger as in voxl-px4-start. Differences from live:
#   - Parameters come from /data/px4/param/sim_parameters, a copy of the live
#     file with the SIH overlay below. The live file is only read.
#   - No IMU, barometer, magnetometer, GPS, power monitor, distance or
#     airspeed drivers. SIH provides the sensors.
#   - No motor-output driver: neither voxl_esc nor voxl2_io is started, so
#     the ESC UART is never opened. pwm_out_sim feeds simulator_sih.
#   - No sih_vio_bridge: VIO is simulated by voxl-mvx-simulator, not by PX4.
#   - temperature_compensation, sensor_imu_raw_bridge and
#     voxl_save_cal_params are not started (no real sensors, and sim
#     calibration values must not be saved).
#   - The pose link (UDP 14620 -> 14621) streams HIL_STATE_QUATERNION.
#     voxl-mvx-simulator also sends to PX4 on it (MAVLink).
################################################################################

SIM_PARAM_FILE=/data/px4/param/sim_parameters
LIVE_PARAM_FILE=/data/px4/param/parameters

# Pose link to voxl-mvx-simulator (localhost). PX4 listens on POSE_PORT and
# sends to POSE_REMOTE_PORT.
POSE_PORT=14620
POSE_REMOTE_PORT=14621
POSE_RATE_HZ=200

echo -e "\n*************************"
echo "VOXL-MVX-SIMULATOR SIM MODE (PX4 SIH)"
echo "AIRFRAME: $AIRFRAME"
echo "GPS: $GPS"
echo "RC: $RC"
echo "ESC: $ESC (not started in sim mode)"
echo "OSD: $OSD"
echo "ARTIFACT_MODE: $ARTIFACT_MODE"
echo "PARAMETERS: $SIM_PARAM_FILE"
echo "POSE LINK: udp $POSE_PORT -> $POSE_REMOTE_PORT, HIL_STATE_QUATERNION at $POSE_RATE_HZ Hz"
echo "EXTRA STEPS:"
for i in "${EXTRA_STEPS[@]}"
do
    echo -e "\t$i"
done
echo -e "*************************\n"

# Figure out what platform we are running on.
PLATFORM=`/usr/bin/voxl-platform 2> /dev/null`
RETURNCODE=$?
if [ $RETURNCODE -ne 0 ]; then
    VERSIONSTRING=""
    if [ -f /etc/version ]; then
        VERSIONSTRING=$(</etc/version)
    fi
    M0052SUBSTRING="M0052"
    if [[ "$VERSIONSTRING" == *"$M0052SUBSTRING"* ]]; then
        PLATFORM="M0052"
    fi
fi

# Same platform support as voxl-px4-start
if [ $PLATFORM = "M0052" ]; then
    /bin/echo "Running on M0052"
    /bin/echo "Error M0052 is no longer supported!!!"
    exit 1
elif [ $PLATFORM = "M0054" ]; then
    /bin/echo "Running on M0054"
elif [ $PLATFORM = "M0104" ]; then
    /bin/echo "Running on M0104"
elif [ $PLATFORM = "M0197" ]; then
    /bin/echo "Running on M0197"
else
    /bin/echo "Error, cannot determine platform!"
    exit 1
fi

# Sleep a little here. A lot happens when the uorb and muorb start
# and we need to make sure that it all completes successfully to avoid
# any possible race conditions.
/bin/sleep 1

# The sim parameter file is normally created by voxl-mvx-mode on entry to sim
# mode (a copy of the live file plus the airframe's SIH parameter set). If it
# is missing, start from a copy of the live file. The live file is only read,
# never selected.
if [ ! -f $SIM_PARAM_FILE ]; then
    if [ -f $LIVE_PARAM_FILE ]; then
        /bin/echo "[WARNING] $SIM_PARAM_FILE not found, copying it from $LIVE_PARAM_FILE"
        /bin/cp $LIVE_PARAM_FILE $SIM_PARAM_FILE
        /bin/sync
    else
        /bin/echo "[WARNING] $SIM_PARAM_FILE not found and no live file to copy, using defaults"
    fi
fi

param select $SIM_PARAM_FILE

# Same defaults as voxl-px4-start
param set-default EKF2_EV_CTRL 15
qshell param set-default EKF2_EV_CTRL 15

param load

# SIH overlay. Set on every sim boot, so a stale or hand-edited sim file can't
# leave SIH unable to run. Everything else keeps the aircraft's live value.
# Simulated IMU (device ID 1310988 = DRV_IMU_DEVTYPE_SIM), identity calibration
param set CAL_ACC0_ID 1310988
param set CAL_ACC0_PRIO 75
param set CAL_ACC0_ROT -1
param set CAL_ACC0_XOFF 0.0
param set CAL_ACC0_YOFF 0.0
param set CAL_ACC0_ZOFF 0.0
param set CAL_ACC0_XSCALE 1.0
param set CAL_ACC0_YSCALE 1.0
param set CAL_ACC0_ZSCALE 1.0
param set CAL_GYRO0_ID 1310988
param set CAL_GYRO0_PRIO 75
param set CAL_GYRO0_ROT -1
param set CAL_GYRO0_XOFF 0.0
param set CAL_GYRO0_YOFF 0.0
param set CAL_GYRO0_ZOFF 0.0
# SIH samples are in the body frame, so no board rotation or level offsets
param set SENS_BOARD_ROT 0
param set SENS_BOARD_X_OFF 0.0
param set SENS_BOARD_Y_OFF 0.0
param set SENS_BOARD_Z_OFF 0.0
# simulator_sih reads output i as motor i+1 in the standard PX4 quad X order.
# This is NOT the VOXL_ESC_FUNC physical-ESC mapping.
param set HIL_ACT_FUNC1 101
param set HIL_ACT_FUNC2 102
param set HIL_ACT_FUNC3 103
param set HIL_ACT_FUNC4 104
# No battery_status source in sim mode yet (live battery comes from the ESC
# driver, which is not started)
param set CBRK_SUPPLY_CHK 894281
param save

# Auto detect an ncp5623c i2c RGB LED. If one isn't connected this will
# fail but not cause any harm.
/bin/echo "Looking for ncp5623c RGB LED"
qshell rgbled_ncp5623c start -X -b 1 -f 400 -a 56

param touch SYS_AUTOCONFIG
param touch SYS_AUTOSTART

# Simulation on the DSP: physics and IMU, barometer, motor outputs
/bin/echo "Starting PX4 SIH on DSP"
qshell simulator_sih start
qshell sensor_baro_sim start
if [ "$GPS" != "NONE" ]; then
    /bin/echo "Starting simulated GPS"
    qshell sensor_gps_sim start
fi
if param compare SYS_HAS_MAG 1
then
    /bin/echo "Starting simulated magnetometer"
    qshell sensor_mag_sim start
fi

# No motor-output driver in sim mode. The ESC UART is never opened.
/bin/echo "Sim mode: not starting an ESC driver, starting pwm_out_sim"
qshell pwm_out_sim start

# RC driver: the real RC receiver, same as voxl-px4-start
if [ "$RC" == "FAKE_RC_INPUT" ]; then
    /bin/echo "Starting fake RC driver"
    qshell rc_controller start
elif [ "$RC" == "CRSF_RAW" ]; then
    /bin/echo "Starting CRSF RC driver"
    qshell crsf_rc start -d 7
elif [ "$RC" == "ELRS_MAVLINK" ]; then
    /bin/echo "Starting ELRS Mavlink driver"
    qshell virtual_serial_endpoint start -p 7 -b 460800 -v 100
elif [ "$RC" == "CRSF_MAV" ]; then
    /bin/echo "Starting TBS crossfire RC - MAV Mode"
    qshell mavlink_rc_in start -m -p 7 -b 115200
elif [ "$RC" == "SPEKTRUM" ]; then
    /bin/echo "Starting Spektrum RC"
    qshell spektrum_rc start
elif [ "$RC" == "GHST" ]; then
    /bin/echo "Starting GHST RC driver"
    qshell ghst_rc start -d 7
elif [ "$RC" == "M0065_SBUS" ]; then
    # In live mode the new-firmware M0065 SBUS path is the voxl2_io driver,
    # which can also drive PWM ESCs. No motor-output driver may run in sim
    # mode, so only the original-firmware dsp_sbus driver is tried here.
    /bin/echo "Attempting to start M0065 SBUS RC driver for original M0065 FW"
    qshell dsp_sbus start
    retVal=$?
    if [ $retVal -ne 0 ]; then
        /bin/echo "[ERROR] dsp_sbus failed. voxl2_io is not started in sim mode, so there is no RC"
    fi
fi

# Start all of the processing modules on DSP
qshell sensors start
qshell ekf2 start

if [ "$AIRFRAME" == "FIXED_WING" ]; then
	qshell fw_pos_control start
	qshell fw_att_control start
	qshell fw_rate_control start
	qshell airspeed_selector start
	qshell fw_autotune_attitude_control start
	qshell land_detector start fixedwing
elif [ $AIRFRAME = "MULTICOPTER" ]; then
	qshell mc_pos_control start
	qshell mc_att_control start
	qshell mc_rate_control start
	qshell mc_hover_thrust_estimator start
	qshell mc_autotune_attitude_control start
	qshell land_detector start multicopter
fi

qshell manual_control start
qshell control_allocator start
qshell load_mon start
qshell rc_update start

qshell commander start

# Start the parameter selector to have various speed modes for a given flight mode
qshell param_set_selector start

# This is needed for altitude and position hold modes
qshell flight_mode_manager start

# Start the dataman service on the applications processor before navigator on DSP
dataman start
qshell navigator start

# Start the applications processor bridges and services (as voxl-px4-start,
# without sensor_imu_raw_bridge: there is no real IMU)
crsf_bridge start
vfc_logger start
vehicle_air_data_bridge start
sensor_baro_bridge start
vehicle_attitude_bridge start
vehicle_local_position_bridge start

# Start uxrce_dds_client for ros2 offboard messages from agent over localhost
uxrce_dds_client start -t udp -h 127.0.0.1 -p 8888

# voxl_save_cal_params is not started: sim calibration must not be saved

# start the onboard fast link to connect to voxl-mavlink-server
mavlink start -x -u 14556 -o 14557 -r 100000 -n lo -m onboard

# slow down some of the fastest streams
mavlink stream -u 14556 -s HIGHRES_IMU -r 10
mavlink stream -u 14556 -s ATTITUDE -r 10
mavlink stream -u 14556 -s ATTITUDE_QUATERNION -r 10
mavlink stream -u 14556 -s GLOBAL_POSITION_INT -r 30
mavlink stream -u 14556 -s SCALED_PRESSURE -r 10

# Increase heartbeat rate so VFC can get faster mode updates
mavlink stream -u 14556 -s HEARTBEAT -r 10

# start the slow normal mode for voxl-mavlink-server to forward to GCS
mavlink start -x -u 14558 -o 14559 -r 100000 -n lo

# Start another Mavlink instance if we are getting Mavlink directly via ELRS
if [ "$RC" == "ELRS_MAVLINK" ]; then
    /bin/echo "Starting Mavlink instance for external ELRS driver"
    mavlink start -x -u 14660 -o 14661 -r 100000 -n lo
fi

# Pose link to voxl-mvx-simulator: SIH groundtruth as HIL_STATE_QUATERNION
mavlink start -x -u $POSE_PORT -o $POSE_REMOTE_PORT -r 200000 -n lo -m minimal
mavlink stream -u $POSE_PORT -s HIL_STATE_QUATERNION -r $POSE_RATE_HZ

mavlink boot_complete

# Optional MSP OSD driver for DJI or HDZero goggles (same as voxl-px4-start)
if [ "$OSD" == "ENABLE" ] || [ "$OSD" == "DJI" ] || [ "$OSD" == "MSP_DJI" ]; then
    /bin/echo "Starting DJI OSD driver"
    msp_osd start -d /dev/ttyHS1
elif [ "$PLATFORM" == "M0054" ] && [ "$OSD" == "HDZERO" ] || [ "$OSD" == "DJI_MSP_DP" ]; then
    /bin/echo "Starting $OSD OSD driver for $PLATFORM"
    msp_dp_osd start -d /dev/ttyHS1
elif [ "$PLATFORM" == "M0104" ] && [ "$OSD" == "HDZERO" ] || [ "$OSD" == "DJI_MSP_DP" ] ; then
    /bin/echo "Starting $OSD OSD driver for $PLATFORM"
    msp_dp_osd start -d /dev/ttyHS0
fi

# Start optional EXTRA_STEPS
for i in "${EXTRA_STEPS[@]}"
do
    $i
done

if [ "$ARTIFACT_MODE" == "ENABLE" ]; then
	# Same artifact-mode handling as voxl-px4-start: no logger, and saved logs
	# and the dataman file are shredded.
	/usr/bin/find /data/px4/log -name "*.ulg" -exec /usr/bin/shred -u -n 7 {} \;
	/bin/rm -fR /data/px4/log
	/usr/bin/shred -u -n 7 /data/px4/dataman
    /bin/echo "Artifact mode has been enabled"
else
	# Start logging module last, as in voxl-px4-start.
	# Set logger mode based on SDLOG_MODE parameter:
	#   0: log when armed until disarm (default)
	#   1: log from boot until disarm
	#   2: log from boot until shutdown
	#   3: log based on AUX1 RC channel
	#   4: log from first armed until shutdown
	LOGGER_ARGS=""
	if param compare SDLOG_MODE 1
	then
		LOGGER_ARGS="-e"
	fi
	if param compare SDLOG_MODE 2
	then
		LOGGER_ARGS="-f"
	fi
	if param compare SDLOG_MODE 3
	then
		LOGGER_ARGS="-x"
	fi
	if param compare SDLOG_MODE 4
	then
		LOGGER_ARGS="-a"
	fi
	logger start $LOGGER_ARGS
fi
