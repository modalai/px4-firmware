#!/bin/bash
# EKF2 replay on the apps processor (same pattern as voxl-px4-hitl).
# Replays a flight ULog through ekf2zai in replay mode; no SLPI, no sensors.

print_usage() {
    echo -e "\nUsage: voxl-px4-replay <flight-log.ulg>"
    echo "                [-h (show help)]"
    exit 1
}

while getopts "h" flag
do
    case "${flag}" in
        *) print_usage ;;
    esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || print_usage

if [ ! -f "$1" ]; then
    echo "[ERROR] log file not found: $1"
    print_usage
fi

# the replay module reads the log path from this environment variable
export replay="$(readlink -f "$1")"
echo "[INFO] replaying $replay through ekf2zai"

px4 -s /usr/bin/voxl-px4-replay-start
